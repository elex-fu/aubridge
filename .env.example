# aubridge 本地开发环境变量模板。
# 复制为 .env(不入 git,.gitignore 已排除),填入真实 key。

# ---- 上游免费档 key(至少配一个可跑 M1 验收)----
# 智谱开放平台(免费注册):https://open.bigmodel.cn
KEY_ZHIPU=
# OpenRouter(free 档):https://openrouter.ai/keys
KEY_OPENROUTER=
# ModelScope:https://modelscope.cn
KEY_MODELSCOPE=

# ---- 订阅源 key ----
# Kimi Coding Plan(Anthropic 协议透传,验收脚本 accept-kimi.sh 使用)
KEY_KIMI_CODE=

# ---- 网络(本机 chatgpt.com DNS 污染时走本地代理)----
# reqwest 默认读取 HTTP_PROXY/HTTPS_PROXY 环境变量。
# 本机 Clash 类代理(127.0.0.1:7890)示例:
# HTTPS_PROXY=http://127.0.0.1:7890
